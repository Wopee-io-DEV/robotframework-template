# Wopee.io project settings (filled in by Wopee.io when the project was created)
WOPEE_API_URL={wopeeApiUrl}
WOPEE_PROJECT_UUID={wopeeProjectUuid}
WOPEE_PROJECT_URL={wopeeProjectUrl}
# Paste a key from Commander › More › Settings › API Keys (never commit .env)
WOPEE_API_KEY=
# Robot Framework (wopee_rf): without these two lines the keywords send nothing
WOPEE_SCREENSHOT_VALIDATION_ENABLED=true
WOPEE_DRIVER_LIBRARY=BrowserLibrary
